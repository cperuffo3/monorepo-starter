{
  "name": "monorepo-starter",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "dev:full": "docker-compose -f docker/docker-compose.yml up -d --wait && pnpm db:generate && pnpm db:migrate && turbo dev",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @starter/api db:migrate",
    "db:studio": "pnpm --filter @starter/api db:studio",
    "db:generate": "pnpm --filter @starter/api db:generate",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "type-check": "turbo type-check",
    "check": "pnpm lint:fix && pnpm type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rimraf node_modules",
    "init-project": "pnpm install && node scripts/init.mjs",
    "gen": "node scripts/generate.mjs",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@release-it/conventional-changelog": "^11.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint-plugin-tailwind-canonical-classes": "^1.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "release-it": "^20.2.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  }
}
